// Fast modular exponentiation (square and multiply): base^exponent mod m in about log2(exponent) steps.
// m must be at most 46340 so that the product of two remainders fits in an int.

int powMod(int base, int exponent, int m)
{
    int result = 1 % m;
    base %= m;
    while (exponent > 0) {
        if (exponent % 2) result = result * base % m; // odd exponent (C style: nonzero is true)
        base = base * base % m;
        exponent /= 2;
    }
    return result;
}

// The same computation as recursion, with immutable bindings only.
int powModRecursive(int base, int exponent, int m)
{
    if (exponent == 0) return 1 % m;
    let half = powModRecursive(base, exponent / 2, m);
    let square = half * half % m;
    return exponent % 2 == 0 ? square : square * (base % m) % m;
}

bool isPrime(int n)
{
    if (n < 2) return false;
    for (int d = 2; d * d <= n; d++) {
        if (n % d == 0) return false;
    }
    return true;
}

int main()
{
    print(powMod(2, 10, 1000));          // 24: 1024 mod 1000
    print(powMod(3, 200, 13));           // 9
    print(powModRecursive(3, 200, 13));  // 9
    print(powMod(7, 0, 1));              // 0: everything is 0 mod 1

    // Fermat: if n is prime then 2^(n-1) mod n is 1. These odd composites pass that test anyway.
    for (int n = 3; n < 1000; n += 2) {
        if (powMod(2, n - 1, n) == 1 && !isPrime(n)) print(n);   // 341 561 645
    }
    return 0;
}

// Expected output, checked by the test suite:
//! out: 24
//! out: 9
//! out: 9
//! out: 0
//! out: 341
//! out: 561
//! out: 645
