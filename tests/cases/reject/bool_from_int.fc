// C stores any nonzero number in a bool as true, and so does Functional C by default
// (see tests/cases/run/int_to_bool.fc). With --strict it is an error: write 'n != 0' or 'true'.
int main()
{
    bool flag = 1;
    return 0;
}

//! flags: --strict
//! error: FC3007 5:17 cannot initialize the bool variable 'flag' with a value of type int
