// An int counts as true or false in conditions and logical operators, but it is not converted when
// it is stored in a bool (C would store nonzero as true). Write 'n != 0' or 'true' instead.
int main()
{
    bool flag = 1;
    return 0;
}

//! error: FC3007 5:17 cannot initialize the bool variable 'flag' with a value of type int
