//! out: 0
//! out: 1
//! out: 2
//! out: 2
//! out: 5
//! out: 1
//! out: 2
//! out: -1
//! out: 0
//! out: 1
//! out: 1
//! out: 5
//! out: 0
//! out: 2
//! exit: 1
