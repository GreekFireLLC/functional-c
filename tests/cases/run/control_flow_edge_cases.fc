int mark(int x)
{
    print(x);
    return x;
}

// The else branch always returns, so the code after the if runs only on the then path.
int elseReturns(bool c)
{
    if (c) {
        print(1);
    } else {
        return 2;
    }
    return 3;
}

// continue in an inner loop does not affect the outer loop.
int innerContinue()
{
    int total = 0;
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            if (j == 1) continue;
            total += 10;
        }
        total += 1;
    }
    return total;
}

// continue and return in the same loop.
int continueAndReturn(int limit)
{
    int sum = 0;
    for (int i = 0; i < 100; i++) {
        if (i % 2 == 1) continue;
        if (i > limit) return sum;
        sum += i;
    }
    return -1;
}

// A while condition with a side effect runs once per iteration, plus the final failing test.
int conditionCalls()
{
    int n = 0;
    while (mark(n) < 2) {
        n++;
    }
    return n;
}

// return from an else-if chain inside an infinite loop.
int loopElseIf(int x)
{
    while (true) {
        if (x > 10) {
            return 1;
        } else if (x < 0) {
            return -1;
        } else {
            x = x * 3 - 5;
        }
    }
}

// Functions that only loop forever never fall off their end; they must still translate and compile.
int spinForever()
{
    while (true) {
    }
}

int spinForeverToo()
{
    for (;;) ;
}

int main()
{
    print(elseReturns(true));
    print(elseReturns(false));
    print(innerContinue());
    print(continueAndReturn(6));
    print(conditionCalls());
    print(loopElseIf(4));
    print(loopElseIf(1));

    // Empty statements, and a while loop with an empty body whose condition has the side effect.
    int calls = 0;
    ;
    while (mark(calls) < 0) ;
    return 0;
}

//! out: 1
//! out: 3
//! out: 2
//! out: 63
//! out: 12
//! out: 0
//! out: 1
//! out: 2
//! out: 2
//! out: 1
//! out: -1
//! out: 0
