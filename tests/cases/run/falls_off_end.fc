// A function that reaches its closing brace without a return is legal C; using its value is
// undefined there. Functional C defines it: the function returns 0 (false for a bool), with
// warning FC3005. main is the exception C itself makes: reaching its end returns 0, with no warning.
// (With --strict each of these is an error.)

int sign(int x)
{
    if (x < 0) {
        return -1;
    } else if (x > 0) {
        return 1;
    }
}

bool found(int x)
{
    while (x > 0) {
        if (x == 7) return true;
        x--;
    }
}

int nothing()
{
}

char letter(int n)
{
    if (n == 1) return 'a';
}

int main()
{
    print(sign(-9));                   // -1
    print(sign(9));                    // 1
    print(sign(0));                    // 0
    print(found(10));                  // 1
    print(found(5));                   // 0
    print(nothing());                  // 0
    print(letter(1));                  // 97
    print(letter(2));                  // 0
}

//! out: -1
//! out: 1
//! out: 0
//! out: 1
//! out: 0
//! out: 0
//! out: 97
//! out: 0
//! exit: 0
//! warning: FC3005 13:1 function 'sign' can reach its end without returning a value; it returns 0 there
//! warning: FC3005 21:1 function 'found' can reach its end without returning a value; it returns false there
//! warning: FC3005 25:1 function 'nothing' can reach its end without returning a value; it returns 0 there
//! warning: FC3005 30:1 function 'letter' can reach its end without returning a value; it returns 0 there
//! fs-contains: let nothing () : int =
