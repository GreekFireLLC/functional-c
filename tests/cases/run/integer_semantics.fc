// Signed 32-bit integers with .NET semantics: division truncates toward zero, the remainder has the
// sign of the dividend, and + - * and unary minus wrap around (two's complement) on overflow.
int max()
{
    return 2147483647;
}

int min()
{
    return -2147483648;
}

int main()
{
    print(7 / 2);
    print(-7 / 2);
    print(7 / -2);
    print(-7 / -2);
    print(7 % 2);
    print(-7 % 2);
    print(7 % -2);
    print(-7 % -2);
    print(max() + 1);
    print(min() - 1);
    print(-min());
    print(max() * 2);
    print(-2147483648);
    print(2147483647);
    print(min() / 1);
    return 0;
}

//! out: 3
//! out: -3
//! out: -3
//! out: 3
//! out: 1
//! out: -1
//! out: 1
//! out: -1
//! out: -2147483648
//! out: 2147483647
//! out: -2147483648
//! out: -2
//! out: -2147483648
//! out: 2147483647
//! out: -2147483648
