int main()
{
    print(2 + 3 * 4);
    print((2 + 3) * 4);
    print(10 - 4 - 3);
    print(100 / 10 / 5);
    print(-2 * 3);
    print(2 + 3 > 4 ? 1 : 0);
    print(!false && false ? 1 : 0);
    print(true || false && false ? 1 : 0);
    print(false ? 1 : true ? 2 : 3);
    print(1 + 2 == 3 ? 1 : 0);
    print(7 % 3 * 2);
    print(- -5);
    return 0;
}

//! out: 14
//! out: 20
//! out: 3
//! out: 2
//! out: -6
//! out: 1
//! out: 0
//! out: 1
//! out: 2
//! out: 1
//! out: 2
//! out: 5
