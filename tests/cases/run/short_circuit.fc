int explode()
{
    return 1 / 0;
}

int mark(int x)
{
    print(x);
    return x;
}

int main()
{
    print(false && explode() == 0 ? 1 : 2);
    print(true || explode() == 0 ? 3 : 4);
    print(true && mark(5) == 5 ? 6 : 7);
    print(false || mark(8) == 9 ? 10 : 11);
    return 0;
}

//! out: 2
//! out: 3
//! out: 5
//! out: 6
//! out: 8
//! out: 11
