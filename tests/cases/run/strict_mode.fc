// --strict rejects what C merely tolerates, but a program that says what it means still translates:
// explicit comparisons and casts, initialized variables, and a return on every path.

bool isOdd(int n)
{
    return n % 2 != 0;
}

int main()
{
    int n = 7;
    bool odd = isOdd(n);
    bool nonzero = (bool) n;
    char letter = 'a' + n;
    int asInt = odd;                   // a bool as an int was accepted before version 1.3 too
    print(odd);                        // 1
    print(nonzero);                    // 1
    print(letter);                     // 104
    print(asInt + nonzero);            // 2
    if (n) {
        print(1);                      // a number as a condition is also accepted
    }
    return 0;
}

//! flags: --strict
//! out: 1
//! out: 1
//! out: 104
//! out: 2
//! out: 1
