// "int x;" declares a variable without a value. C leaves the value indeterminate; Functional C
// starts it at 0 (false for a bool). (With --strict this is an error.)

int main()
{
    int total;
    bool seen;
    char c;
    unsigned char u;
    int a, b = 5, i;
    print(total);                      // 0
    print(seen);                       // 0
    print(c);                          // 0
    print(u);                          // 0
    print(a + b);                      // 5
    for (i = 1; i <= 4; i++) {
        total += i;
    }
    print(total);                      // 10
    seen = total;
    print(seen);                       // 1
    return 0;
}

//! out: 0
//! out: 0
//! out: 0
//! out: 0
//! out: 5
//! out: 10
//! out: 1
//! fs-contains: let mutable total = 0
//! fs-contains: let mutable seen = false
//! fs-contains: let c = 0y
//! fs-contains: let u = 0uy
